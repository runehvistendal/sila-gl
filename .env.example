# Kopier som .env.local og udfyld. (Supabase, Cloudinary osf. sættes som i dit projekt.)

# Offentlig base-URL (Stripe return/refresh links)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Samme oprindelse til Sanity Presentation / Visual Editing iframe (frontend)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API-læses token (Contributor+) — Presentation draft-mode + unpublished indhold på serveren
SANITY_API_READ_TOKEN=

# Stripe (Connect onboarding + senere betalinger/webhooks)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
